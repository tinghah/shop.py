# Environment variables (create this file locally)
# Do NOT commit this to GitHub!

BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
ACCOUNT_NUMBER=your_phone_number
ACCOUNT_NAME=Your Name

# Webhook mode (optional - for production deployment)
# If WEBHOOK_URL is set, bot runs in webhook mode instead of polling
# WEBHOOK_URL=https://myapp.onrender.com
# PORT=8443